{
  "name": "slmarket-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.4.0",
    "@neondatabase/serverless": "0.10.4",
    "@prisma/adapter-neon": "5.22.0",
    "@prisma/client": "5.22.0",
    "@protomaps/basemaps": "^5.7.2",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.7.0",
    "countries-list": "^3.3.0",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.492.0",
    "maplibre-gl": "^6.11.2",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "pmtiles": "^4.5.0",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.77.0",
    "react-qr-code": "^2.2.0",
    "resend": "^6.12.4",
    "supercluster": "^9.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.1.4",
    "@tailwindcss/oxide-linux-x64-musl": "4.1.4",
    "lightningcss-linux-x64-gnu": "1.29.2",
    "lightningcss-linux-x64-musl": "1.29.2"
  }
}
